<Window x:Class="NeuralNetwork.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neural Network Trainer"
        Width="1240" Height="820"
        MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020"
        Foreground="#F2F5FB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0B1020" />
        <SolidColorBrush x:Key="PanelBrush" Color="#121A2B" />
        <SolidColorBrush x:Key="PanelRaisedBrush" Color="#172237" />
        <SolidColorBrush x:Key="InputBrush" Color="#0D1525" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#26344D" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F5FB" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AAAC2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7C9CFF" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#91ACFF" />
        <SolidColorBrush x:Key="DangerBrush" Color="#D95770" />
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#EC6B83" />
        <SolidColorBrush x:Key="GreenBrush" Color="#59D6A5" />

        <Style TargetType="Button">
            <Setter Property="Background" Value="#202D44" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="#34445F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2B3B57" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#0B1020" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource DangerBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        </Style>
        <Style x:Key="StepperButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="17" />
            <Setter Property="Width" Value="21" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#24334D" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#26344D" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="NEURAL NETWORK TRAINER" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Training workspace" FontSize="27" FontWeight="SemiBold" Margin="0,3,0,2" />
                <TextBlock Text="Configure the model, run training, and track the metrics that matter."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Width="154" Margin="0,0,10,0">
                    <TextBlock Text="BACKEND" FontSize="10" FontWeight="Bold" Margin="2,0,0,5"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox x:Name="BackendCombo" SelectedIndex="0">
                        <ComboBoxItem Content="GPU (ILGPU)" />
                        <ComboBoxItem Content="SIMD (CPU)" />
                        <ComboBoxItem Content="Scalar (CPU)" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Width="132">
                    <TextBlock Text="ACCELERATOR" FontSize="10" FontWeight="Bold" Margin="2,0,0,5"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <ComboBox x:Name="AcceleratorCombo" SelectedIndex="0">
                        <ComboBoxItem Content="Device 0" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Progress strip -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="TRAINING PROGRESS" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="ProgressText" Grid.Column="1" Text="0%" HorizontalAlignment="Right"
                               FontSize="13" FontWeight="SemiBold" />
                </Grid>
                <ProgressBar x:Name="TrainingProgress" Grid.Row="1" Height="8" Minimum="0" Maximum="100"
                             Value="0" Margin="0,12,0,10" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProgressStatusText" Text="Waiting for a training run"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="RunStateText" Grid.Column="1" Text="READY" HorizontalAlignment="Right"
                               FontSize="10" FontWeight="Bold" Foreground="{StaticResource GreenBrush}" />
                </Grid>
            </Grid>
        </Border>

        <!-- Main workspace -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <!-- Architecture -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="NETWORK ARCHITECTURE" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="Layer configuration" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button x:Name="ModeButton" Grid.Column="1" Content="MODE: NEW" Width="132"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource QuietButtonStyle}" Click="ModeButton_Click"
                                ToolTip="Switch between creating a new network and loading an existing one." />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <TextBlock x:Name="PathLabel" Text="SAVE NETWORK TO" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="1,0,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ModelPathBox" Text="save.nn" Height="36" />
                            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Margin="8,0,0,0"
                                    Style="{StaticResource QuietButtonStyle}" Click="BrowseButton_Click" />
                        </Grid>
                    </StackPanel>

                    <Grid x:Name="LayerEditorPanel" Grid.Row="2" Margin="0,18,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="LAYERS" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="Input and output sizes are editable too." FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button x:Name="AddLayerButton" Grid.Column="1" Content="＋  Add layer"
                                Style="{StaticResource QuietButtonStyle}" Click="AddLayerButton_Click" />
                    </Grid>

                    <ScrollViewer x:Name="LayersScrollViewer" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="LayersPanel" />
                    </ScrollViewer>

                    <TextBlock Grid.Row="4" x:Name="LayerModeHint" Text="New network mode · add hidden layers before the output layer."
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="1,10,0,0"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- Run settings and metrics -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="17" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="TEST ACCURACY" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="AccuracyText" Text="—" FontSize="30" FontWeight="SemiBold"
                                       Margin="0,7,0,3" />
                            <TextBlock Text="Latest test result" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="17" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="LOSS" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock x:Name="LossText" Text="—" FontSize="30" FontWeight="SemiBold"
                                       Margin="0,7,0,3" />
                            <TextBlock Text="Latest training loss" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="RUN SETTINGS" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="Training schedule" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>

                        <Grid Grid.Row="1" Margin="0,16,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,9,0">
                                <TextBlock Text="ITERATIONS" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="1,0,0,6" />
                                <Grid Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="IterationsBox" Text="10" HorizontalContentAlignment="Center"
                                             FontWeight="SemiBold" PreviewTextInput="DigitsOnly_PreviewTextInput" />
                                    <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                        <Button Content="▲" Style="{StaticResource StepperButtonStyle}" Click="IterationsUp_Click" />
                                        <Button Content="▼" Style="{StaticResource StepperButtonStyle}" Click="IterationsDown_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                <TextBlock Text="RECYCLES" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="1,0,0,6" />
                                <Grid Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="RecyclesBox" Text="1" HorizontalContentAlignment="Center"
                                             FontWeight="SemiBold" PreviewTextInput="DigitsOnly_PreviewTextInput" />
                                    <StackPanel Grid.Column="1" Margin="3,0,0,0">
                                        <Button Content="▲" Style="{StaticResource StepperButtonStyle}" Click="RecyclesUp_Click" />
                                        <Button Content="▼" Style="{StaticResource StepperButtonStyle}" Click="RecyclesDown_Click" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Border Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,0,0,13" />
                            <CheckBox x:Name="MultiThreadCheck" Content="Enable parallel training / testing"
                                      Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="LEARNING RATE" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="Reported by your trainer" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="LearningRateText" Grid.Column="1" Text="—" FontSize="16"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="QUICK NOTE" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="The UI doesn't assume how your Trainer, Tester, NetworkFile, or IBackend are implemented. Hook the start/stop events into your existing training code, then push progress and metrics back to this window."
                                   TextWrapping="Wrap" FontSize="12" LineHeight="19"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom action bar -->
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="Ready to train" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="Check the model mode and settings before starting." FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0" />
            </StackPanel>
            <Button x:Name="StartStopButton" Grid.Column="1" Content="▶  START TRAINING"
                    Width="220" Height="48" FontSize="13" Style="{StaticResource AccentButtonStyle}"
                    Click="StartStopButton_Click" />
        </Grid>
    </Grid>
</Window>
